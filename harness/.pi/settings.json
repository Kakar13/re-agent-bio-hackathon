{
  "defaultProvider": "anthropic",
  "defaultThinkingLevel": "medium",
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:@langchain/langsmith-pi-extension"
  ],
  "skills": ["../../skills"],
  "prompts": ["./prompts"],
  "sessionDir": ".pi/sessions",
  "enableSkillCommands": true,
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  }
}
