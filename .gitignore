# Secrets
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# Notebooks
.ipynb_checkpoints/

# Data and generated outputs (keep folder structure)
data/raw/*
data/processed/*
results/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!results/.gitkeep
# MegaScale parquet stays local; README + ignore file are tracked
!data/raw/megascale_tsuboyama2023/
!data/raw/megascale_tsuboyama2023/.gitignore
!data/raw/megascale_tsuboyama2023/README.md
# AlphaSeq parquet stays local; README + ignore file are tracked
!data/raw/open_alphaseq/
!data/raw/open_alphaseq/.gitignore
!data/raw/open_alphaseq/README.md
# Affinity pipeline docs (CSVs stay under data/processed/)
!data/README.md
# Binder target docs (PDBs stay local / gitignored)
!data/targets/
!data/targets/README.md
!data/targets/*_hotspots_report.json
*.fasta
*.pdb
*.cif
*.sdf
*.h5
*.parquet

# Tool caches
.paperclip/
.proto/
.modal/

# Pi: ignore caches; keep committed project settings under harness/
.pi/
!harness/.pi/
harness/.pi/**
!harness/.pi/settings.json
!harness/.pi/langsmith.json
!harness/.pi/prompts/
!harness/.pi/prompts/**
!harness/.pi/extensions/
!harness/.pi/extensions/**

# OS / editor
.DS_Store
.idea/
*.swp
*.swo

# Logs
*.log
logs/
