# Secrets
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# Notebooks
.ipynb_checkpoints/

# Data and generated outputs (keep folder structure)
data/raw/*
data/processed/*
results/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!results/.gitkeep
# Binder target docs / hotspot audits (PDBs stay gitignored)
!data/targets/
!data/targets/README.md
!data/targets/*_hotspots_report.json
# RFD3 binder report (PDBs stay gitignored under results/)
!results/rfd3_binders/
!results/rfd3_binders/report.md
!results/rfd3_binders/summary.json
!results/rfd3_binders/*/control_qc.json
*.fasta
*.pdb
*.cif
*.sdf
*.h5
*.parquet

# Tool caches
.paperclip/
.proto/
.modal/

# Pi: ignore caches; keep committed project settings under harness/
.pi/
!harness/.pi/
harness/.pi/**
!harness/.pi/settings.json
!harness/.pi/langsmith.json
!harness/.pi/prompts/
!harness/.pi/prompts/**
!harness/.pi/extensions/
!harness/.pi/extensions/**

# OS / editor
.DS_Store
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Isolated tool environments (pinned deps that conflict with the main venv)
.tools/
