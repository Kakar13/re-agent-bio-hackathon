# Secrets
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# Notebooks
.ipynb_checkpoints/

# Data and generated outputs (keep folder structure)
data/raw/*
data/processed/*
results/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/processed/immuno/
!data/processed/immuno/.gitignore
!data/processed/immuno/fixtures/
!data/processed/immuno/fixtures/**
!results/.gitkeep
*.fasta
!data/raw/immuno_tests/
!data/raw/immuno_tests/**
*.pdb
*.cif
*.sdf
*.h5
*.parquet

# Tool caches
.paperclip/
.proto/
.modal/

# Pi: ignore caches; keep committed project settings under harness/
.pi/
!harness/.pi/
harness/.pi/**
!harness/.pi/settings.json
!harness/.pi/langsmith.json
!harness/.pi/prompts/
!harness/.pi/prompts/**
!harness/.pi/extensions/
!harness/.pi/extensions/**

# OS / editor
.DS_Store
.idea/
*.swp
*.swo

# Logs
*.log
logs/
