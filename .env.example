# Copy to .env and fill in keys from the hackathon Discord / lightning talks.
#   cp .env.example .env

# Direct-script fallback; the project is also installed as a src-layout package.
PYTHONPATH=src

# Anthropic — Claude API credits from the event (also used by Pi)
ANTHROPIC_API_KEY=

# LangSmith — Pi session traces (turns, tools, tokens)
# Key: https://docs.langchain.com/langsmith/create-account-api-key
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=re-agent-scientific-workbench
# Pi extension specifically checks TRACE_TO_LANGSMITH; ./run.sh maps
# LANGSMITH_TRACING → TRACE_TO_LANGSMITH automatically.
# TRACE_TO_LANGSMITH=true

# Shared runtime and workbench
RE_AGENT_MODEL=claude-sonnet-4-6
NEXT_PUBLIC_LANGGRAPH_API_URL=http://localhost:2024
# Optional direct link shown in the UI:
# NEXT_PUBLIC_LANGSMITH_PROJECT_URL=https://smith.langchain.com/...

# Proto (Arc Institute) — hosted MCP + proto-client SDK
# Get a key from your Proto workspace, then: export PROTO_API_KEY=...
PROTO_API_KEY=

# Optional LangGraph-owned Paperclip MCP bearer token. Without it, the runtime
# uses the authenticated Paperclip CLI as a fallback; Cursor/Pi OAuth sessions
# are intentionally not shared with the deployed graph worker.
PAPERCLIP_API_KEY=
PAPERCLIP_MCP_BEARER_TOKEN=

# Hugging Face — only needed for gated Proto models (ESM3, AlphaFold3, AlphaGenome)
HF_TOKEN=

# Modal — preferred auth is `uv run modal setup` (writes ~/.modal.toml).
# Env tokens below are optional fallback only; do not invent them.
# A single MODAL_API_KEY is not consumed by the Modal SDK.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Optional local overrides
# PROTO_HOME=~/.proto
# PROTO_MODEL_CACHE=~/.proto/weights
